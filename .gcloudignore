# GCP Cloud Build ignore file
# Speeds up source upload by excluding unnecessary files

.git/
.gitignore
.gitmodules

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
dist/
build/
.venv/
venv/

# Local runtime files
/log/
/run/
/data/

# Tests and docs (not needed in container)
tests/
design/
docs/

# Markdown files (except README)
*.md
!README.md

# Environment
.env
.env.*

# Misc
wheelhouse/
wheels/
.gcloudignore
Dockerfile.gcp

# Cloud upload is a separate boundary from Docker's build context.
etc/ssl/
etc/sign_cert/
etc/sign_verify/
etc/conf/server.conf
etc/conf/persistence.conf
etc/conf/integration_credentials.conf
**/cipher.key
**/*.pem
**/*.key
**/*.cer
**/*.p12
**/*.pfx
**/credentials*.json
**/auth.local.json
**/.env
**/.env.*
**/*credentials*.conf
etc/config/models.yaml
common/config/models.yaml
common/config/llm_config.json
registry-center-web/
**/node_modules/
reviews/
.claude/
.codex/
.agents/
