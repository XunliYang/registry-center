openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
# Configure allowed TLS groups - exclude ffdhe2048, include stronger DH groups
# Note: Only applicable to OpenSSL 3.0+, as FFDH group support in TLS 1.3 starts from 3.0
Groups = x25519:prime256v1:x448:secp521r1:secp384r1:ffdhe3072:ffdhe4096:ffdhe6144:ffdhe8192

# Operator notes:
# - OpenSSL loads this file only when the OPENSSL_CONF environment variable
#   points at it. The systemd unit etc/systemd/registry-center.service does that
#   (bin/install_service.sh rewrites the path to the install directory); the
#   container image neither sets OPENSSL_CONF nor copies this file, so containers
#   use the OpenSSL defaults and these group restrictions do not apply there.
# - The Groups line above is the complete policy: it fixes the TLS 1.3 named
#   groups and the ECDHE groups used by TLS 1.2. Removing an entry makes
#   handshakes that need it fail; ffdhe2048 is intentionally absent because it is
#   too small. The directive is ignored (with no warning from the application) on
#   OpenSSL versions older than 3.0.
# - The cipher suites themselves are NOT configured here; they come from
#   tls.cipher in etc/conf/server.properties.
# - Nothing in the application reads OPENSSL_CONF or parses this file: only the
#   OpenSSL library loaded by the interpreter acts on it, and it does so at
#   library initialisation. A file the runtime does not process (older OpenSSL,
#   unset variable) is therefore ignored silently, without any application log
#   line. Confirm the effective groups on the target host, for example with
#   `openssl s_client -connect <host>:<port> -groups ffdhe2048` and checking that
#   the handshake is rejected.
